{
  "name": "lettuce-home",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 5173",
    "build": "vite build",
    "preview": "wrangler dev --port 5173",
    "prepare": "pnpm run types && svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check . && eslint .",
    "types": "wrangler types",
    "ship": "wrangler deploy"
  },
  "devDependencies": {
    "@content-collections/core": "^0.15.3",
    "@content-collections/vite": "^0.3.1",
    "@eslint/compat": "^2.1.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "catalog:",
    "@iconify/json": "^2.2.560",
    "@iconify/tailwind4": "^1.2.3",
    "@internationalized/date": "^3.12.4",
    "@lettuce-apps-packages/svelte-common": "workspace:*",
    "@sveltejs/adapter-cloudflare": "^9.0.0",
    "@sveltejs/enhanced-img": "^1.0.1",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^26",
    "bits-ui": "^2.22.0",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.24.1",
    "globals": "^17.14.0",
    "ky": "catalog:",
    "layerchart": "^2.11.0",
    "mdsvex": "^1.0.1",
    "prettier": "catalog:",
    "prettier-plugin-svelte": "^4.2.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "tailwindcss": "catalog:",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.73.0",
    "valibot": "catalog:",
    "vite": "catalog:",
    "wrangler": "catalog:"
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*",
    "#content-collections": "./.content-collections/generated/index.js",
    "#content/*": "./src/content/*"
  }
}
