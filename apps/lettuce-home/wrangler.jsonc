{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lettuce-home",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_als", "nodejs_compat"],
  "assets": {
    "directory": ".svelte-kit/cloudflare",
    "binding": "ASSETS",
  },
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "logs": {
      "enabled": true,
      "invocation_logs": true,
    },
  },
}
