{
  "name": "wordlettuce",
  "version": "0.0.1",
  "scripts": {
    "dev": "vite dev --host 0.0.0.0 --port 3000",
    "build": "vite build",
    "package": "svelte-kit package",
    "preview": "vite preview --host 0.0.0.0 --port 3000",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --ignore-path ../../.gitignore --check . && eslint .",
    "find": "prettier --find-config-path .",
    "prepare": "svelte-kit sync",
    "ship": "wrangler deploy -c wrangler.jsonc"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261011.1",
    "@eslint/js": "^10.0.1",
    "@fontsource-variable/inter": "catalog:",
    "@lettuce-apps-packages/auth": "workspace:*",
    "@lettuce-apps-packages/svelte-common": "workspace:*",
    "@sveltejs/adapter-cloudflare": "^8.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/js-cookie": "^3.0.6",
    "@types/node": "^26.6.5",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "autoprefixer": "^10.6.1",
    "bits-ui": "^2.19.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "js-cookie": "^3.0.8",
    "ky": "catalog:",
    "postcss": "^8.5.29",
    "runed": "^0.37.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "svelte2tsx": "^0.7.61",
    "svoast": "^3.0.3",
    "tailwindcss": "catalog:",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.0",
    "typescript-eslint": "^8.71.1",
    "valibot": "catalog:",
    "vite": "catalog:",
    "vite-plugin-devtools-json": "^1.1.1",
    "wrangler": "catalog:"
  },
  "type": "module",
  "imports": {
    "#lib/*": "./src/lib/*"
  }
